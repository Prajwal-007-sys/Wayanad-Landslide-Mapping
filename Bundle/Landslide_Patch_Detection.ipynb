    "# Plot displacement raster and overlay patch geometries\n",
    "disp_data = tifffile.imread(\"displacement.tif\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 6))\n",
    "im = ax.imshow(disp_data, cmap=\"RdBu\", vmin=-25, vmax=25, extent=[622912, 624908, 1266736, 1268752])\n",
    "cbar = fig.colorbar(im, ax=ax, label=\"LOS Displacement (mm)\", fraction=0.03, pad=0.04)\n",
    "\n",
    "# Overlay candidate patch polygons\n",
    "downslope_gdf = gdf[gdf[\"Motion_Type\"] == \"Downslope\"]\n",
    "uplift_gdf = gdf[gdf[\"Motion_Type\"] == \"Toe_Uplift\"]\n",
    "\n",
    "downslope_gdf.plot(ax=ax, facecolor=\"red\", edgecolor=\"darkred\", alpha=0.5, label=\"Downslope Motion (< -5 mm)\")\n",
    "uplift_gdf.plot(ax=ax, facecolor=\"cyan\", edgecolor=\"blue\", alpha=0.5, label=\"Toe Uplift (> +5 mm)\")\n",
    "\n",
    "plt.title(\"InSAR Landslide Candidate Patches Overlaid on Displacement Map\", fontsize=14)\n",
    "plt.xlabel(\"UTM Easting (m)\", fontsize=12)\n",
    "plt.ylabel(\"UTM Northing (m)\", fontsize=12)\n",
    "plt.legend(loc=\"upper right\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"candidate_landslide_patches_map.png\", dpi=300)\n",
    "plt.show()\n"
   ]
