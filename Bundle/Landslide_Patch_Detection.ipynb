   "source": [
    "import matplotlib.pyplot as plt\n",
    "import rasterio\n",
    "from rasterio.plot import plotting_extent\n",
    "from pyproj import Transformer\n",
    "from matplotlib.ticker import MaxNLocator\n",
    "\n",
    "# ============================================================\n",
    "# Read displacement GeoTIFF\n",
    "# ============================================================\n",
    "with rasterio.open(\"displacement.tif\") as src:\n",
    "    disp = src.read(1)\n",
    "    extent = plotting_extent(src)\n",
    "    raster_crs = src.crs\n",
    "\n",
    "# ============================================================\n",
    "# Transformer:\n",
    "# Raster CRS <-> WGS84 (Latitude/Longitude)\n",
    "# ============================================================\n",
    "to_wgs84 = Transformer.from_crs(\n",
    "    raster_crs,\n",
    "    \"EPSG:4326\",\n",
    "    always_xy=True\n",
    ")\n",
    "\n",
    "to_raster = Transformer.from_crs(\n",
    "    \"EPSG:4326\",\n",
    "    raster_crs,\n",
    "    always_xy=True\n",
    ")\n",
    "\n",
    "# ============================================================\n",
    "# Plot raster\n",
    "# ============================================================\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "im = ax.imshow(\n",
    "    disp,\n",
    "    cmap=\"RdBu\",\n",
    "    vmin=-25,\n",
    "    vmax=25,\n",
    "    extent=extent,\n",
    "    origin=\"upper\"\n",
    ")\n",
    "\n",
    "cbar = plt.colorbar(im, ax=ax)\n",
    "cbar.set_label(\"LOS Displacement (mm)\")\n",
    "\n",
    "# ============================================================\n",
    "# Nice number of axis ticks\n",
    "# ============================================================\n",
    "ax.xaxis.set_major_locator(MaxNLocator(6))\n",
    "ax.yaxis.set_major_locator(MaxNLocator(6))\n",
    "\n",
    "xticks = ax.get_xticks()\n",
    "yticks = ax.get_yticks()\n",
    "\n",
    "# ============================================================\n",
    "# Convert UTM ticks -> Longitude\n",
    "# ============================================================\n",
    "lon_labels = []\n",
    "\n",
    "for x in xticks:\n",
    "    lon, _ = to_wgs84.transform(x, yticks[0])\n",
    "    lon_labels.append(f\"{lon:.5f}\")\n",
    "\n",
    "# ============================================================\n",
    "# Convert UTM ticks -> Latitude\n",
    "# ============================================================\n",
    "lat_labels = []\n",
    "\n",
    "for y in yticks:\n",
    "    _, lat = to_wgs84.transform(xticks[0], y)\n",
    "    lat_labels.append(f\"{lat:.5f}\")\n",
    "\n",
    "# ============================================================\n",
    "# Apply labels\n",
    "# ============================================================\n",
    "ax.set_xticks(xticks)\n",
    "ax.set_xticklabels(\n",
    "    lon_labels,\n",
    "    rotation=45,\n",
    "    ha=\"right\"\n",
    ")\n",
    "\n",
    "ax.set_yticks(yticks)\n",
    "ax.set_yticklabels(lat_labels)\n",
    "\n",
    "ax.set_xlabel(\"Longitude (°)\")\n",
    "ax.set_ylabel(\"Latitude (°)\")\n",
    "\n",
    "# ============================================================\n",
    "# Your GPS Point\n",
    "# ============================================================\n",
    "# Points to mark (Latitude, Longitude)\n",
    "# ============================================================\n",
    "\n",
    "points = [\n",
    "    (\"Point 1\", 11.465104, 76.134982),   # DMS point converted to decimal\n",
    "    (\"Point 2\", 11.465440, 76.135910),\n",
    "    (\"Point 3\", 11.465940, 76.136110),\n",
    "    (\"Point 4\", 11.466480, 76.136390),\n",
    "    (\"Point 5\", 11.46782, 76.13770)   # New point\n",
    "]\n",
    "\n",
    "# Plot each point\n",
    "for name, lat, lon in points:\n",
    "\n",
    "    # Convert WGS84 -> Raster CRS\n",
    "    x, y = to_raster.transform(lon, lat)\n",
    "\n",
    "    # Plot point\n",
    "    ax.scatter(\n",
    "        x,\n",
    "        y,\n",
    "        marker=\"*\",\n",
    "        s=250,\n",
    "        color=\"yellow\",\n",
    "        edgecolors=\"black\",\n",
    "        linewidth=1.5,\n",
    "        zorder=10\n",
    "    )\n",
    "\n",
    "    # Label point\n",
    "    ax.annotate(\n",
    "        name,\n",
    "        (x, y),\n",
    "        xytext=(8, 8),\n",
    "        textcoords=\"offset points\",\n",
    "        fontsize=9,\n",
    "        color=\"black\",\n",
    "        bbox=dict(\n",
    "            facecolor=\"white\",\n",
    "            edgecolor=\"black\",\n",
    "            alpha=0.8\n",
    "        )\n",
    "    )\n",
    "\n",
    "ax.legend(loc=\"upper right\")\n",
    "\n",
    "ax.set_title(\"LOS Displacement Map\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
